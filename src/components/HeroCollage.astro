---
import Polaroid from './decor/Polaroid.astro';
import StickyNote from './decor/StickyNote.astro';
import Doodle from './decor/Doodle.astro';
import { media } from '../data/media';
---
<div class="collage" data-parallax>
  <div class="photo-main" data-parallax-layer="0.6"><Polaroid image={media.workspace} caption="building things, one curious experiment at a time." eager /></div>
  <div class="photo-small" data-parallax-layer="1"><Polaroid image={media.mountains} caption="a more curious life." /></div>
  <div class="photo-travel" data-parallax-layer="1.3"><Polaroid image={media.journey} caption="live a good story." /></div>
  <div class="collage-note" aria-hidden="true"><StickyNote>keep building.<br />keep exploring.</StickyNote></div>
  <div class="collage-sticker" aria-hidden="true">BUILD<br />WRITE<br />EXPLORE</div>
  <Doodle class="collage-arrow" /><Doodle kind="mountain" class="collage-mountain" />
</div>
<style>
.collage {
  position: relative;
  min-height: 38rem;
  background: var(--color-collage);
  isolation: isolate;
}
.photo-main,
.photo-small,
.photo-travel {
  position: absolute;
  transform: translate(var(--px, 0px), var(--py, 0px))
    rotate(var(--photo-angle));
  transition: transform var(--duration-base) var(--ease-out);
}
.photo-main {
  width: 73%;
  top: 14%;
  left: 7%;
  --photo-angle: 2deg;
  z-index: 1;
}
.photo-small {
  width: 29%;
  top: 9%;
  right: 2%;
  --photo-angle: 7deg;
  z-index: 2;
}
.photo-travel {
  width: 34%;
  right: 7%;
  bottom: 9%;
  --photo-angle: -7deg;
  z-index: 2;
}
.photo-small :global(img) {
  aspect-ratio: 1.35;
}
.photo-travel :global(img) {
  aspect-ratio: 1.2;
}
.collage-note {
  position: absolute;
  left: 7%;
  bottom: 9%;
  z-index: 3;
  font-size: 1.05rem;
}
.collage-sticker {
  position: absolute;
  right: 2%;
  top: 37%;
  z-index: 3;
  border-radius: 50%;
  display: grid;
  place-content: center;
  text-align: center;
  line-height: 1.15;
  width: 5.5rem;
  height: 5.5rem;
  background: var(--color-sticker);
  color: #28251a;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 700;
  transform: rotate(9deg);
  box-shadow: var(--shadow-soft);
}
.collage :global(.collage-arrow) {
  position: absolute;
  right: 11%;
  top: 48%;
  width: 8rem;
  z-index: 3;
}
.collage :global(.collage-mountain) {
  position: absolute;
  left: 8%;
  bottom: 26%;
  width: 6rem;
  z-index: 3;
}
@media (max-width: 64rem) {
  .collage {
    min-height: 36rem;
    max-width: 45rem;
    width: 100%;
    margin: auto;
  }
  .photo-main {
    width: 66%;
    left: 9%;
  }
  .photo-small {
    right: 6%;
    width: 27%;
  }
}
@media (max-width: 40rem) {
  .collage {
    min-height: 27rem;
  }
  .photo-main {
    top: 12%;
    left: 7%;
    width: 76%;
  }
  .photo-small {
    display: none;
  }
  .photo-travel {
    width: 36%;
    bottom: 11%;
    right: 6%;
  }
  .collage-note {
    left: 7%;
    bottom: 12%;
    font-size: 0.85rem;
  }
  .collage-sticker {
    width: 4.1rem;
    height: 4.1rem;
    top: 7%;
    right: 4%;
    font-size: 0.6rem;
  }
  .collage :global(.collage-arrow),
  .collage :global(.collage-mountain) {
    display: none;
  }
}
</style>
