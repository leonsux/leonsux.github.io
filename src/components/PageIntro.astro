---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="page-intro page-shell">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p>{description}</p>
</header>

<style>
  .page-intro {
    display: grid;
    padding-block: clamp(4rem, 8vw, 6.5rem) clamp(2.75rem, 6vw, 4rem);
    border-bottom: 1px solid var(--color-line);
    gap: 0.85rem clamp(2rem, 7vw, 6rem);
    grid-template-columns: minmax(7.5rem, 0.22fr) minmax(0, 1fr);
  }

  .eyebrow {
    margin: 0;
    padding-top: 0.45rem;
  }

  h1 {
    max-width: 16ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 6vw, 4.8rem);
    line-height: 1.02;
    letter-spacing: -0.055em;
  }

  .page-intro > p:last-child {
    max-width: 50rem;
    margin: 0.2rem 0 0;
    color: var(--color-muted);
    font-size: clamp(1rem, 2vw, 1.15rem);
    grid-column: 2;
  }

  @media (max-width: 42rem) {
    .page-intro {
      gap: 0.8rem;
      grid-template-columns: 1fr;
    }

    .eyebrow {
      padding: 0;
    }

    .page-intro > p:last-child {
      grid-column: 1;
    }
  }
</style>
