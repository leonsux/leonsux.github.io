---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<header class="page-intro page-shell">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p>{description}</p>
</header>

<style>
  .page-intro {
    padding-block: clamp(4rem, 10vw, 7rem) clamp(2.5rem, 6vw, 4rem);
  }

  h1 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.8rem, 7vw, 5.4rem);
    line-height: 1.05;
    letter-spacing: -0.06em;
  }

  .page-intro > p:last-child {
    max-width: 48rem;
    margin: 1.4rem 0 0;
    color: var(--color-muted);
    font-size: clamp(1rem, 2vw, 1.15rem);
  }
</style>
