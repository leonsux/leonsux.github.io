---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
interface Props { featured?: boolean; }
const { featured = false } = Astro.props;
const visible = projects.filter(project => project.published && (!featured || project.featured));
---
<div class="project-grid">{visible.map(project => <ProjectCard project={project} />)}</div>
<style>
.project-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.5rem;
  align-items: start;
}
@media (max-width: 64rem) {
  .project-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media (max-width: 40rem) {
  .project-grid {
    grid-template-columns: 1fr;
  }
}
</style>
