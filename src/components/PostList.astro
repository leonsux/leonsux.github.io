---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils/posts';
import { displayText } from '../utils/typography';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<div class="post-list">
  {posts.map(({ data }) => (
    <article>
      <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>
      <div>
        <h2><a href={data.permalink}>{displayText(data.title)}</a></h2>
        <p>{displayText(data.description)}</p>
        <div class="tags">
          {data.tags.map((tag) => <a href={`/tags/#${encodeURIComponent(tag)}`}>#{tag}</a>)}
        </div>
      </div>
    </article>
  ))}
</div>

<style>
  .post-list {
    display: grid;
  }

  article {
    display: grid;
    padding-block: clamp(1.65rem, 3vw, 2.25rem);
    border-top: 1px solid var(--color-line);
    gap: 1rem clamp(2rem, 5vw, 5rem);
    grid-template-columns: 9rem minmax(0, 1fr);
  }

  time {
    padding-top: 0.35rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.25;
    letter-spacing: -0.04em;
  }

  h2 a {
    text-decoration: none;
  }

  article:hover h2 a {
    color: var(--color-accent);
  }

  p {
    max-width: 50rem;
    margin: 0.7rem 0 0.8rem;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
  }

  .tags a {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-decoration: none;
  }

  .tags a:active {
    transform: translateY(1px);
  }

  @media (max-width: 38rem) {
    article {
      grid-template-columns: 1fr;
    }

    time {
      padding: 0;
    }
  }
</style>
