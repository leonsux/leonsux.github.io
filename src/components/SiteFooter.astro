---
import { site } from '../data/site';
---
<footer>
  <div class="page-shell footer-inner">
    <div><a class="signature" href="/">Leonsux ✳</a><p>Try EveryThing · 保持好奇，慢慢构建。</p><small>© {new Date().getFullYear()} Leonsux</small></div>
    <div class="footer-links"><a href="/archive/">归档</a><a href="/tags/">标签</a><a href="/feed.xml">RSS</a><a href={site.github} target="_blank" rel="noreferrer">GitHub ↗</a><a href={site.juejin} target="_blank" rel="noreferrer">掘金 ↗</a><a href={`mailto:${site.email}`}>Email ↗</a></div>
  </div>
</footer>
<style>
footer {
  border-top: 1px solid var(--color-line);
  padding-block: 3rem;
  font-size: 0.85rem;
}
.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 2rem;
}
.signature {
  font: italic 1.65rem var(--font-display);
  text-decoration: none;
}
p {
  margin: 0.5rem 0 1rem;
  color: var(--color-muted);
}
small {
  color: var(--color-muted);
}
.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem 1.5rem;
}
.footer-links a {
  text-decoration: none;
  padding-block: 0.5rem;
}
@media (max-width: 48rem) {
  .footer-inner {
    align-items: start;
    flex-direction: column;
  }
}
</style>
