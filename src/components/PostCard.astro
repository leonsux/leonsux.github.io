---
interface Props {
  title: string;
  description: string;
  href: string;
  publishedAt: Date;
  tags: string[];
}

const { title, description, href, publishedAt, tags } = Astro.props;
const formattedDate = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(publishedAt);
---

<article>
  <div class="post-meta">
    <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
    {tags[0] && <span>{tags[0]}</span>}
  </div>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  <a class="read-more" href={href} aria-label={`阅读《${title}》`}>阅读全文 <span aria-hidden="true">↗</span></a>
</article>

<style>
  article {
    display: flex;
    min-height: 14.5rem;
    padding: clamp(1.2rem, 2.5vw, 1.5rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-surface) 78%, transparent);
    box-shadow: 0 1rem 3rem transparent;
    flex-direction: column;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  article:hover {
    border-color: rgb(7 94 229 / 45%);
    box-shadow: var(--shadow-soft);
    transform: translateY(-0.2rem);
  }

  .post-meta {
    display: flex;
    margin-bottom: 1.1rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    gap: 0.75rem;
    letter-spacing: 0.02em;
  }

  .post-meta span::before {
    margin-right: 0.75rem;
    content: "·";
  }

  h3 {
    margin: 0;
    font-size: clamp(1.2rem, 2.5vw, 1.45rem);
    line-height: 1.35;
    letter-spacing: -0.025em;
  }

  h3 a {
    text-decoration: none;
  }

  p {
    display: -webkit-box;
    margin: 0.75rem 0 1.2rem;
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.94rem;
    line-height: 1.75;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .read-more {
    margin-top: auto;
    color: var(--color-accent);
    font-size: 0.86rem;
    font-weight: 700;
    text-decoration: none;
  }
</style>
