---
import { displayText } from '../utils/typography';
interface Props { title: string; description: string; href: string; publishedAt: Date; tags: string[]; }
const { title, description, href, publishedAt, tags } = Astro.props;
const date = publishedAt.toISOString().slice(0,10).replaceAll('-', '.');
---
<article>
  <div class="post-meta"><time datetime={publishedAt.toISOString()}>{date}</time><span>{tags[0]}</span></div>
  <h3><a class="hover-arrow" href={href}>{displayText(title)} <span aria-hidden="true">↗</span></a></h3>
  <p>{displayText(description)}</p>
</article>
<style>
article {
  min-width: 0;
  border-top: 1px solid #ffffff35;
  padding-block: 1.5rem;
}
.post-meta {
  display: flex;
  gap: 1rem;
  color: var(--color-forest-muted);
  font: 0.7rem/1.6 var(--font-mono);
}
h3 {
  margin: 0.6rem 0;
  font: 500 clamp(1.4rem, 2.2vw, 1.8rem)/1.4 var(--font-display);
}
h3 a {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 0.75rem;
  text-decoration: none;
}
h3 a:hover {
  color: #f6c39a;
}
h3 span {
  flex: 0 0 auto;
  font: 1.2rem var(--font-sans);
}
p {
  margin: 0;
  color: var(--color-forest-muted);
  font-size: 0.85rem;
  max-width: 55ch;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
</style>
