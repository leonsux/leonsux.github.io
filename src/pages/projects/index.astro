---
import PageIntro from '../../components/PageIntro.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="项目" description="leonsux 的 AI 产品、网页工具与交互实验。">
  <PageIntro eyebrow="Selected work" title="项目" description="从 AI 陪伴应用到纯前端交互实验。这里关注的不是技术栈清单，而是一个想法如何被做成可用的东西。" />
  <section class="projects page-shell" aria-label="代表项目">
    <ProjectGrid />
  </section>
</BaseLayout>

<style>
  .projects {
    padding-block: clamp(3rem, 6vw, 4.5rem) clamp(4rem, 10vw, 8rem);
  }
</style>
