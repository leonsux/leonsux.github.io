---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featuredPosts = posts.filter(({ data }) => data.featured).slice(0, 3);
---

<BaseLayout>
  <section class="hero page-shell">
    <div class="hero-copy">
      <p class="eyebrow">Full-stack engineer · AI builder</p>
      <h1>把技术变成产品，<br /><span>把实践写成方法。</span></h1>
      <p class="intro">
        我是 leonsux，一名全栈开发工程师与 AI 产品实践者。这里记录我在 AI 编程工具、产品构建和知识管理中的真实探索。
      </p>
      <div class="hero-actions">
        <a class="primary-action" href="#writing">阅读文章</a>
        <a class="secondary-action" href="https://github.com/leonsux" target="_blank" rel="noreferrer">查看 GitHub</a>
      </div>
    </div>
    <aside class="focus-card" aria-label="当前关注">
      <p>NOW / 2026</p>
      <ul>
        <li><span>01</span>AI 编程与 Agent 工程</li>
        <li><span>02</span>从想法到产品的实现路径</li>
        <li><span>03</span>个人知识与内容工作流</li>
      </ul>
    </aside>
  </section>

  <section id="writing" class="writing page-shell" aria-labelledby="writing-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Selected writing</p>
        <h2 id="writing-title">工程笔记精选</h2>
      </div>
      <span>2016—2022</span>
    </div>
    <div class="post-grid">
      {featuredPosts.map(({ data }) => (
        <PostCard
          title={data.title}
          description={data.description}
          href={data.permalink}
          publishedAt={data.publishedAt}
          tags={data.tags}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    min-height: min(45rem, calc(100svh - 4.5rem));
    padding-block: clamp(4rem, 10vw, 8rem);
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
    grid-template-columns: minmax(0, 1.45fr) minmax(17rem, 0.7fr);
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3rem, 7.8vw, 6.6rem);
    line-height: 1.04;
    letter-spacing: -0.065em;
  }

  h1 span {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-text);
  }

  .intro {
    max-width: 42rem;
    margin: 2rem 0 0;
    color: var(--color-muted);
    font-size: clamp(1rem, 2vw, 1.18rem);
  }

  .hero-actions {
    display: flex;
    margin-top: 2rem;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .hero-actions a {
    display: inline-flex;
    min-height: 2.9rem;
    padding: 0.65rem 1.05rem;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    font-weight: 750;
    text-decoration: none;
  }

  .primary-action {
    color: white;
    background: var(--color-accent);
  }

  .primary-action:hover {
    color: white;
    background: var(--color-accent-strong);
  }

  .secondary-action {
    border: 1px solid var(--color-line);
    background: rgb(255 253 248 / 65%);
  }

  .focus-card {
    padding: 1.4rem;
    border: 1px solid rgb(7 94 229 / 25%);
    border-radius: var(--radius-md);
    background: rgb(255 253 248 / 72%);
    box-shadow: var(--shadow-soft);
    transform: rotate(1.5deg);
  }

  .focus-card > p {
    margin: 0 0 1rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .focus-card ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    gap: 0.2rem;
  }

  .focus-card li {
    display: grid;
    padding-block: 0.85rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.9rem;
    font-weight: 650;
    gap: 0.8rem;
    grid-template-columns: auto 1fr;
  }

  .focus-card li span {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .writing {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .section-heading > span {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .post-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 52rem) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .focus-card {
      max-width: 31rem;
      transform: none;
    }

    .post-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 32rem) {
    h1 span {
      color: var(--color-text);
      -webkit-text-stroke: 0;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
