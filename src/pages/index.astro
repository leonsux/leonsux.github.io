---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PaperSection from '../components/decor/PaperSection.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import PostCard from '../components/PostCard.astro';
import NowCard from '../components/NowCard.astro';
import AboutSection from '../components/AboutSection.astro';
import { sortPosts } from '../utils/posts';
const latestPosts = sortPosts(await getCollection('blog', ({ data }) => !data.draft)).slice(0,3);
---
<BaseLayout title="Leonsux · Try EveryThing">
  <Hero />
  <PaperSection id="projects" label="精选项目"><SectionHeading title="Featured projects" note="things I've been building" description="把一些想法，做成可以使用、体验和继续生长的东西。" href="/projects/" linkText="所有项目" /><ProjectGrid featured /></PaperSection>
  <PaperSection id="writing" tone="forest" torn label="文章与近况">
    <div class="writing-grid"><div><SectionHeading title="Writing & thoughts" note="notes from the journey" href="/posts/" linkText="所有文章" />{latestPosts.map(({data}) => <PostCard title={data.title} description={data.description} href={data.permalink} publishedAt={data.publishedAt} tags={data.tags} />)}</div><div class="now-wrap" id="now"><NowCard /></div></div>
  </PaperSection>
  <PaperSection id="about" tone="sage" label="关于作者"><AboutSection /></PaperSection>
</BaseLayout>
<style>
.writing-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
  gap: clamp(2rem, 5vw, 5rem);
  align-items: start;
}
.now-wrap {
  padding-top: 2rem;
}
.writing-grid :global(.section-heading > a) {
  color: var(--color-forest-muted);
}
.writing-grid :global(.section-heading .handwritten) {
  color: #f5ba91;
}
@media (max-width: 64rem) {
  .writing-grid {
    grid-template-columns: 1fr;
  }
  .now-wrap {
    max-width: 36rem;
    width: 100%;
    margin-inline: auto;
  }
}
</style>
